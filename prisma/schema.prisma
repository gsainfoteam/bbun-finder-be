generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Mbti {
  INFJ
  ENFJ
  INTJ
  ENTJ
  INFP
  ENFP
  INTP
  ENTP
  ISFJ
  ESFJ
  ISTJ
  ESTJ
  ISFP
  ESFP
  ISTP
  ESTP
}

enum Department {
  EC     // 전기전자컴퓨터공학과
  SE     // 반도체공학과
  AI     // AI융합학과
  PS     // 물리광과학과
  CH     // 화학과
  MM     // 수리과학과
  MA     // 신소재공학과
  MC     // 기계로봇공학과
  EV     // 환경에너지공학과
  BS     // 생명과학과
  GS     // 도전탐색과정
}

enum ChatMessageStatus {
  ACTIVE
  DELETED
}

model User {
  uuid            String    @id @db.Uuid
  name            String
  studentNumber   String    @unique @map("student_number")
  email           String    @unique
  profileImageUrl String?   @map("profile_image_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  consent         Boolean   @default(false)

  department  Department? @map("department")
  MBTI        Mbti?       @map("mbti")
  instaId     String?     @map("insta_id")
  description String?     @map("description")

  chatRoomMembers ChatRoomMember[]
  chatMessages    ChatMessage[] @relation("ChatMessageSender")

  blockedUsers UserBlock[] @relation("UserBlocker")
  blockedBy    UserBlock[] @relation("UserBlocked")


  @@map("user")
}

model ChatRoom {
  uuid      String   @id @default(uuid()) @db.Uuid
  lineKey   String   @unique @map("line_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  members  ChatRoomMember[]
  messages ChatMessage[]

  @@map("chat_room")
}

model ChatRoomMember {
  uuid     String    @id @default(uuid()) @db.Uuid
  roomUuid String    @map("room_uuid") @db.Uuid
  userUuid String    @map("user_uuid") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  room ChatRoom @relation(fields: [roomUuid], references: [uuid], onDelete: Cascade)
  user User     @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)

  @@unique([roomUuid, userUuid])
  @@index([roomUuid])
  @@index([userUuid])
  @@map("chat_room_member")
}

model ChatMessage {
  uuid       String            @id @default(uuid()) @db.Uuid
  roomUuid   String            @map("room_uuid") @db.Uuid
  senderUuid String            @map("sender_uuid") @db.Uuid

  content   String?
  status    ChatMessageStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")

  room   ChatRoom @relation(fields: [roomUuid], references: [uuid], onDelete: Cascade)
  sender User     @relation("ChatMessageSender", fields: [senderUuid], references: [uuid], onDelete: Cascade)

  @@index([roomUuid, createdAt])
  @@index([senderUuid])
  @@map("chat_message")
}

model UserBlock {
  uuid            String   @id @default(uuid()) @db.Uuid
  blockerUserUuid String   @map("blocker_user_uuid") @db.Uuid
  blockedUserUuid String   @map("blocked_user_uuid") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  blocker User @relation("UserBlocker", fields: [blockerUserUuid], references: [uuid], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedUserUuid], references: [uuid], onDelete: Cascade)

  @@unique([blockerUserUuid, blockedUserUuid])
  @@index([blockedUserUuid])
  @@map("user_block")
}
